# 界面操作收集装置 环境变量（可选，默认值见 config.json）
# 与量化项目共用解释器：D:\Python\python.exe

# 量化项目目录（若文件夹位置变化才需要改）
FUTURES_MONITOR_QUANT_DIR=E:\LHsystem\量化\futures_monitor

# 多 CTP 账号扩展空间（可选）：默认自动读取 Legend 的 ctp-login-credentials.json（SimNow 模拟账号）。
# 如需添加实盘/其他账号：编辑 config.json 的 ctp_accounts 列表：
#   "ctp_accounts": [{"site_id": "simnow", "user_id": "270772", "password": "xxx"}]
# 说明：密码只存配置文件，绝不打日志；本文件不入 git。